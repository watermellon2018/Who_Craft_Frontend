  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "api:generate": "node scripts/generate-api-contracts.mjs",
    "api:check": "node scripts/generate-api-contracts.mjs --check",
    "contract:test": "react-scripts test --watchAll=false --runInBand src/api/generation/characters/tree_structure.test.tsx src/api/errors.test.ts src/page/creation/projects/projectFormContract.test.ts src/modules/character-studio/pages/CharacterVariantsPage.test.tsx"
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(three|@react-three)[/\\\\]).+\\.(js|mjs|cjs|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-console": "error"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
